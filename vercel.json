{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "public",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:sido(서울|경기|인천|부산|대구|광주|대전|울산|세종|강원|충북|충남|전북|전남|경북|경남|제주)/:rest*",
      "destination": "/pharmacy/:sido/:rest*",
      "statusCode": 301
    },
    {
      "source": "/지역",
      "destination": "/pharmacy/",
      "statusCode": 301
    },
    {
      "source": "/지역/",
      "destination": "/pharmacy/",
      "statusCode": 301
    },
    {
      "source": "/:sido(%EC%84%9C%EC%9A%B8|%EA%B2%BD%EA%B8%B0|%EC%9D%B8%EC%B2%9C|%EB%B6%80%EC%82%B0|%EB%8C%80%EA%B5%AC|%EA%B4%91%EC%A3%BC|%EB%8C%80%EC%A0%84|%EC%9A%B8%EC%82%B0|%EC%84%B8%EC%A2%85|%EA%B0%95%EC%9B%90|%EC%B6%A9%EB%B6%81|%EC%B6%A9%EB%82%A8|%EC%A0%84%EB%B6%81|%EC%A0%84%EB%82%A8|%EA%B2%BD%EB%B6%81|%EA%B2%BD%EB%82%A8|%EC%A0%9C%EC%A3%BC)/:rest*",
      "destination": "/pharmacy/:sido/:rest*",
      "statusCode": 301
    },
    {
      "source": "/%EC%A7%80%EC%97%AD",
      "destination": "/pharmacy/",
      "statusCode": 301
    },
    {
      "source": "/%EC%A7%80%EC%97%AD/",
      "destination": "/pharmacy/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.svg|apple-touch-icon.png|og.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
